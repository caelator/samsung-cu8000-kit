# Copy this file to .env and fill in the values for this property's LAN.
# IMPORTANT: Never share a populated .env file publicly (it may hold Plex/Jellyseerr tokens).
# Restrict port 8765 to your property's local LAN only (never expose to the public internet).

TZ=UTC
GATEWAY_BIND_IP=0.0.0.0
GATEWAY_PORT=8765

# The LAN URL the CU8000 TVs on this property will use to reach this gateway:
# Example: http://192.168.1.50:8765
PUBLIC_BASE_URL=http://CHANGE_ME_TO_HOST_LAN_IP:8765

# Optional: Plex Media Server (leave blank if this property only uses Ad-Free YouTube)
PLEX_URL=
PLEX_PUBLIC_URL=
PLEX_TOKEN=
PLEX_MACHINE_ID=

# Plex library section IDs (comma-separated integers)
MAIN_MOVIE_SECTIONS=1
MAIN_TV_SECTIONS=2
KIDS_SECTION_IDS=

# Optional: Jellyseerr (leave blank if not used)
JELLYSEERR_URL=
JELLYSEERR_API_KEY=

# YouTube SponsorBlock auto-skip
SPONSORBLOCK_ENABLED=true
ASTC_MAX_CACHE_MB=1024
